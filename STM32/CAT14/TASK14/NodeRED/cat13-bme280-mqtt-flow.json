    "z": "cat13_tab",
    "name": "Extract temperature, humidity, pressure",
    "func": "const p = msg.payload;\nif (!p || p.status !== \"success\" || p.temperature === undefined || p.humidity === undefined || p.pressure === undefined) {\n    node.warn(\"Invalid BME280 JSON payload\");\n    return null;\n}\nmsg.payload = {\n    temperature: Number(p.temperature),\n    humidity: Number(p.humidity),\n    pressure: Number(p.pressure)\n};\nreturn msg;",
